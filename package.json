{
  "name": "smartq",
  "version": "0.1.0",
  "description": "SmartQ MVP exam and assessment platform",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch backend/server.js\" \"vite --host 0.0.0.0\"",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node scripts/check.mjs",
    "verify": "npm run build && node scripts/verify.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "busboy": "^1.6.0",
    "element-plus": "^2.10.4",
    "mammoth": "^1.10.0",
    "pdf-parse": "^1.1.1",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "vite": "^7.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
